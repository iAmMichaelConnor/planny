{
  "name": "planny",
  "version": "0.2.1",
  "description": "A file-backed task and decision tracker for AI-driven projects. CLI, markdown store, localhost UI.",
  "type": "module",
  "bin": {
    "planny": "dist/bin.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "web",
    "skills"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc && chmod +x dist/bin.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "planny": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iAmMichaelConnor/planny.git"
  },
  "homepage": "https://github.com/iAmMichaelConnor/planny#readme",
  "bugs": {
    "url": "https://github.com/iAmMichaelConnor/planny/issues"
  },
  "keywords": [
    "tasks",
    "planning",
    "ai-agents",
    "cli",
    "kanban",
    "decisions"
  ],
  "dependencies": {
    "commander": "^14.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
